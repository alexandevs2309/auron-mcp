# Plantilla de configuración de auron-mcp. Copiar a .env y rellenar.
# Nunca commitear .env: contiene tokens y contraseñas.

# Transporte: stdio (default) o streamable-http
AURON_MCP_TRANSPORT=stdio
AURON_MCP_NAME=AURON MCP

# Seguridad: dejar en true salvo que se haya revisado el flujo de confirmación.
AURON_MCP_READ_ONLY=true

# Adaptador HTTP: `http` usa la API real; `mock` sirve para desarrollo sin backend.
AURON_ADAPTER=http
AURON_API_BASE_URL=https://api.example.com/api
# Token de servicio; dejar vacío si se usa OAuth 2.1 por host.
AURON_API_TOKEN=

# Rate limit y auditoría
AURON_RATE_LIMIT_MAX_CALLS=30
AURON_RATE_LIMIT_WINDOW_SECONDS=60
AURON_AUDIT_LOG_PATH=

# Estado compartido (opcional). Vacío = en memoria, una sola réplica.
AURON_REDIS_URL=
AURON_REDIS_ON_ERROR=closed
AURON_REDIS_TIMEOUT_SECONDS=1

# HTTP (solo cuando AURON_MCP_TRANSPORT=streamable-http)
AURON_MCP_HTTP_HOST=127.0.0.1
AURON_MCP_HTTP_PORT=8765
AURON_MCP_HTTP_PATH=/mcp
AURON_MCP_HTTP_ALLOWED_HOSTS=
AURON_MCP_HTTP_BEARER_TOKEN=
AURON_MCP_HTTP_MAX_BODY_BYTES=4194304
AURON_HTTP_TIMEOUT_SECONDS=15
AURON_IDENTITY_CACHE_TTL=300
AURON_ALLOW_SUPERUSER_NO_TENANT=false

# OAuth 2.1 (opcional; el proveedor sigue en memoria → sticky sessions)
AURON_MCP_OAUTH_ENABLED=false
AURON_MCP_OAUTH_ISSUER_URL=http://127.0.0.1:8765
AURON_MCP_OAUTH_RESOURCE_URL=http://127.0.0.1:8765/mcp
AURON_MCP_OAUTH_SERVICE_DOC_URL=
AURON_MCP_OAUTH_CLIENT_ID=auron-mcp-client
AURON_MCP_OAUTH_CLIENT_SECRET=
AURON_MCP_OAUTH_CLIENT_REDIRECT_URIS=http://127.0.0.1:6274/api/callback
AURON_MCP_OAUTH_DYNAMIC_CLIENT_REGISTRATION=false

# Confirmaciones e idempotencia
AURON_MCP_CONFIRMATION_TTL_SECONDS=300
AURON_MCP_IDEMPOTENCY_TTL_SECONDS=86400
AURON_MCP_IDEMPOTENCY_MAX_ENTRIES=10000

# OpenTelemetry (opcional)
AURON_MCP_OTEL_ENABLED=false
AURON_MCP_OTEL_ENDPOINT=http://127.0.0.1:4318/v1/traces
AURON_MCP_OTEL_SERVICE_NAME=auron-mcp
